#!/usr/bin/env sh

set -ae

VALID_TARGETS="nvim kiro-cli opencode node"
GRACEFUL_WAIT_SECS=5
POLL_INTERVAL=0.2

usage() {
  cat <<EOF
Usage: kill-dev [target ...]

Kill running dev tool instances.

Targets:
  nvim        Neovim (SIGTERM, then SIGKILL)
  kiro-cli    Kiro CLI (SIGTERM, then SIGKILL)
  opencode    OpenCode CLI (SIGTERM, then SIGKILL)
  node        Node (SIGTERM, then SIGKILL)

Default (no args): kill all targets.
EOF
}

pid_in_list() {
  case " $2 " in
  *" $1 "*) return 0 ;;
  esac
  return 1
}

get_tree_pids() {
  gtp_pid="$1"
  gtp_accum="$2"

  if pid_in_list "$gtp_pid" "$gtp_accum"; then
    printf '%s' "$gtp_accum"
    return
  fi

  gtp_children=$(pgrep -P "$gtp_pid" 2>/dev/null || true)

  for gtp_child in $gtp_children; do
    gtp_accum=$(get_tree_pids "$gtp_child" "$gtp_accum")
  done

  if ! pid_in_list "$gtp_pid" "$gtp_accum"; then
    gtp_accum="$gtp_accum $gtp_pid"
  fi

  printf '%s' "$gtp_accum"
}

get_target_pids() {
  gtp2_name="$1"
  if [ "$gtp2_name" = "node" ]; then
    gtp2_roots=$(pgrep -f '(^|/)node ' 2>/dev/null || true)
  else
    gtp2_roots=$(pgrep -x "$gtp2_name" 2>/dev/null || true)
  fi
  if [ -z "$gtp2_roots" ]; then
    return
  fi

  gtp2_all=""
  for gtp2_root in $gtp2_roots; do
    gtp2_all=$(get_tree_pids "$gtp2_root" "$gtp2_all")
  done

  printf '%s\n' "$gtp2_all"
}

is_valid_target() {
  for ivt_t in $VALID_TARGETS; do
    if [ "$1" = "$ivt_t" ]; then
      return 0
    fi
  done
  return 1
}

collect_all_pids() {
  cap_targets="$1"
  cap_all=""
  for cap_target in $cap_targets; do
    cap_pids=$(get_target_pids "$cap_target")
    if [ -n "$cap_pids" ]; then
      for cap_pid in $cap_pids; do
        if ! pid_in_list "$cap_pid" "$cap_all"; then
          cap_all="$cap_all $cap_pid"
        fi
      done
    fi
  done
  printf '%s' "$cap_all"
}

send_term_all() {
  sta_pids="$1"
  for sta_pid in $sta_pids; do
    kill -TERM "$sta_pid" 2>/dev/null || true
  done
}

poll_remaining() {
  pr_pids="$1"
  pr_alive=""
  for pr_pid in $pr_pids; do
    if kill -0 "$pr_pid" 2>/dev/null; then
      pr_alive="$pr_alive $pr_pid"
    else
      echo "killed: $pr_pid (terminated)"
    fi
  done
  printf '%s' "$pr_alive"
}

send_kill_all() {
  ska_pids="$1"
  for ska_pid in $ska_pids; do
    if kill -0 "$ska_pid" 2>/dev/null; then
      kill -9 "$ska_pid" 2>/dev/null || true
      echo "killed: $ska_pid (SIGKILL)"
    fi
  done
}

main() {
  if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
  fi

  if [ $# -eq 0 ]; then
    md_targets="$VALID_TARGETS"
  else
    md_targets="$*"
  fi

  for md_arg in $md_targets; do
    if ! is_valid_target "$md_arg"; then
      echo "unknown target: $md_arg" >&2
      echo "valid targets: $VALID_TARGETS" >&2
      exit 1
    fi
  done

  md_all_pids=$(collect_all_pids "$md_targets")
  if [ -z "$md_all_pids" ]; then
    exit 0
  fi

  send_term_all "$md_all_pids"

  md_elapsed=0
  md_deadline=$((GRACEFUL_WAIT_SECS * 10))
  while [ "$md_elapsed" -lt "$md_deadline" ]; do
    md_alive=$(poll_remaining "$md_all_pids")
    if [ -z "$md_alive" ]; then
      exit 0
    fi
    md_all_pids="$md_alive"
    sleep "$POLL_INTERVAL"
    md_elapsed=$((md_elapsed + 1))
  done

  send_kill_all "$md_all_pids"
}
main "$@"
