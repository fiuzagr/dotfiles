#!/usr/bin/env sh

set -eu

LOG_FILE="$HOME/.local/var/logs/git-merge.log"

git_cmd() {
  if ! git "$@" >>"$LOG_FILE" 2>&1; then
    echo "Git command failed: git $*" >&2
    echo "Check log file: $LOG_FILE" >&2
    exit 1
  fi
}

main() {
  branch="${1:?Usage: git-merge <branch>}"
  current=$(git rev-parse --abbrev-ref HEAD)

  if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    echo "Do not use main or master branch" >&2
    exit 1
  fi

  if [ "$current" = "HEAD" ]; then
    echo "Cannot merge from detached HEAD" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$LOG_FILE")"

  echo "--------------------------------"
  echo "Merging the branches: $branch - $current"

  (
    git_cmd fetch origin
    { git branch -D "$branch" || true; }
    git_cmd checkout "$branch"
    git_cmd pull --ff-only
    git_cmd merge "$current" --no-edit
    git_cmd push -u origin "$branch"
    git_cmd checkout -
  ) || {
    echo "An error occurred while managing branch $branch" >&2
    echo "Check log file: $LOG_FILE" >&2
    exit 1
  }

  echo "Done!"
  echo "--------------------------------"

  return
}
main "$@"
