#!/usr/bin/env sh
set -ae

project="${1:-}"
config_dir="$HOME/.config/up-stack"

if [ -z "$project" ]; then
  printf 'Project name: '
  read -r project
fi

if [ -z "$project" ]; then
  printf 'ERROR: project name is required\n' >&2
  exit 1
fi

case "$project" in
  *[!a-zA-Z0-9-]*)
    printf 'ERROR: project name must be alphanumeric with hyphens\n' >&2
    exit 1
    ;;
esac

config="$config_dir/$project.sh"

if [ -f "$config" ]; then
  printf 'Config already exists: %s\nOverwrite? [Y/n] ' "$config"
  read -r answer
  case "$answer" in
    [nN]*) exit 0 ;;
  esac
fi

printf 'tmux server name [%s]: ' "$project"
read -r tmux_server
if [ -z "$tmux_server" ]; then
  tmux_server="$project"
fi

workspace_dir="$HOME/workspace/$project"

if [ ! -d "$workspace_dir" ]; then
  printf 'ERROR: workspace directory not found: %s\n' "$workspace_dir" >&2
  exit 1
fi

printf '\nScanning %s/...\n\n' "$workspace_dir"

repos=""
custom_cmds=""
skipped=""

for entry in "$workspace_dir"/*; do
  [ -d "$entry" ] || continue

  repo_name=$(basename "$entry")

  case "$repo_name" in
    .*) continue ;;
  esac

  printf '  Found: %s\n' "$repo_name"
  printf '  Include? [Y/n] '
  read -r include

  case "$include" in
    [nN]*)
      if [ -z "$skipped" ]; then
        skipped="$repo_name"
      else
        skipped="$skipped, $repo_name"
      fi
      continue
      ;;
  esac

  if [ -z "$repos" ]; then
    repos="$repo_name"
  else
    repos="$repos $repo_name"
  fi

  printf '  Command:\n'
  printf '    1) npm run dev\n'
  printf '    2) npm start\n'
  printf '    3) npm run start:dev\n'
  printf '    4) Custom\n'
  printf '    5) No server\n'
  printf '  Choice [1]: '
  read -r cmd_choice

  case "$cmd_choice" in
    2) cmd="npm start" ;;
    3) cmd="npm run start:dev" ;;
    4)
      printf '  Command: '
      read -r cmd
      if [ -z "$cmd" ]; then
        cmd="npm run dev"
      fi
      ;;
    5) cmd="" ;;
    *) cmd="npm run dev" ;;
  esac

  if [ "$cmd" != "npm run dev" ] && [ -n "$cmd" ]; then
    if [ -z "$custom_cmds" ]; then
      custom_cmds="$repo_name|$cmd"
    else
      custom_cmds="$custom_cmds
$repo_name|$cmd"
    fi
  elif [ -z "$cmd" ]; then
    if [ -z "$custom_cmds" ]; then
      custom_cmds="$repo_name|"
    else
      custom_cmds="$custom_cmds
$repo_name|"
    fi
  fi

  printf '\n'
done

if [ -z "$repos" ]; then
  printf 'ERROR: at least one repo is required\n' >&2
  exit 1
fi

if [ -n "$skipped" ]; then
  printf 'Skipped: %s\n\n' "$skipped"
fi

mkdir -p "$config_dir"

cat > "$config" <<EOF
TMUX_SERVER=$tmux_server
REPOS="$repos"

cmd_for() {
EOF

if [ -n "$custom_cmds" ]; then
  printf '  case "$1" in\n' >> "$config"
  printf '%s\n' "$custom_cmds" | while IFS='|' read -r repo cmd; do
    [ -z "$repo" ] && continue
    if [ -z "$cmd" ]; then
      printf "    %s) ;;\n" "$repo" >> "$config"
    else
      printf "    %s) printf '%%s\\\\n' \"%s\" ;;\n" \
        "$repo" "$cmd" >> "$config"
    fi
  done
  printf "    *) printf '%%s\\\\n' \"npm run dev\" ;;\n" >> "$config"
  printf '  esac\n' >> "$config"
else
  printf "  printf '%%s\\\\n' \"npm run dev\"\n" >> "$config"
fi

printf '}\n' >> "$config"

printf 'Created %s — run: up-stack %s\n' "$config" "$project"
