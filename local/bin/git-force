#!/usr/bin/env sh

set -eu

LOG_FILE="$HOME/.local/var/logs/git-force.log"

git_cmd() {
  if ! git "$@" >>"$LOG_FILE" 2>&1; then
    echo "Git command failed: git $*" >&2
    echo "Check log file: $LOG_FILE" >&2
    exit 1
  fi
}

main() {
  branch="${1:?Usage: git-force <branch>}"

  if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    echo "Do not use main or master branch" >&2
    exit 1
  fi

  current="$(git_cmd rev-parse --abbrev-ref HEAD)"

  mkdir -p "$(dirname "$LOG_FILE")"

  echo "--------------------------------"
  echo "Overwriting the branch: $branch with $current"

  (
    git_cmd fetch origin
    { git branch -D "$branch" || true; }
    git_cmd branch "$branch" "$current"
    git_cmd push -f origin "$branch"
  ) || {
    echo "An error occurred while managing branch $branch" >&2
    echo "Check log file: $LOG_FILE" >&2
    exit 1
  }

  echo "Done!"
  echo "--------------------------------"
}
main "$@"