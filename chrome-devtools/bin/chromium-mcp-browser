#!/usr/bin/env sh

# Wrapper for Chrome/Chromium with MCP-compatible flags.
# Detects the browser binary at runtime.

chrome_bin=""
for cmd in chromium google-chrome google-chrome-stable chromium-browser; do
  if command -v "$cmd" >/dev/null 2>&1; then
    chrome_bin="$(command -v "$cmd")"
    break
  fi
done

if [ -z "$chrome_bin" ]; then
  echo "Error: No Chrome/Chromium binary found" >&2
  exit 1
fi

case "$chrome_bin" in
  /snap/*) exec "$chrome_bin" --no-sandbox --ignore-certificate-errors "$@" ;;
  *)       exec "$chrome_bin" --ignore-certificate-errors "$@" ;;
esac
